# =============================================================================
# German Newsfeed MCP Server — Environment Configuration
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is git-ignored — never commit secrets.
# =============================================================================

# ── Transport ─────────────────────────────────────────────────────────────────
# stdio           = local Claude Desktop / CLI (default)
# streamable-http = Streamable HTTP for remote / Docker deployments (endpoint: /mcp)
TRANSPORT=stdio

# ── Network (only relevant when TRANSPORT=streamable-http) ───────────────────
HOST=127.0.0.1
PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Upstream API ──────────────────────────────────────────────────────────────
# Local request budget per hour towards the upstream API (token bucket).
RATE_LIMIT_PER_HOUR=60

# Optional contact info for the User-Agent header; omitted entirely when unset.
# USER_AGENT_CONTACT=you@example.org
